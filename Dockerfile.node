# Stage 1: builder — install all deps (including devDeps) and compile TypeScript
FROM node:22-slim AS builder

WORKDIR /app

# Layer 1: deps manifest for cache efficiency
COPY apps/gateway/package.json ./

# Install ALL deps (dev + prod) — tsc, @tsconfig/node22, typescript are devDeps needed here
RUN npm install

# Layer 2: TypeScript source + config, then compile
COPY apps/gateway/src ./src
COPY apps/gateway/tsconfig.json ./
RUN npx tsc

# Stage 2: runtime — production deps only, compiled JS
FROM node:22-slim AS runtime

WORKDIR /app

# Copy package.json and install production deps only (no devDeps: tsc, vitest, tsx, etc.)
COPY --from=builder /app/package.json ./
RUN npm install --omit=dev

# Copy compiled JavaScript from builder
COPY --from=builder /app/dist ./dist

# env vars injected by docker-compose env_file — NOT --env-file flag (different mechanism)
CMD ["node", "dist/index.js"]
