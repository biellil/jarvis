# Stage 1: builder — install all deps (including devDeps) and compile TypeScript
FROM node:22-slim AS builder

WORKDIR /app

RUN npm install -g pnpm@10.33.2

# Workspace context — required for frozen-lockfile and root onlyBuiltDependencies
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
COPY apps/gateway/package.json ./apps/gateway/

# Install ALL deps (dev + prod)
RUN pnpm install --frozen-lockfile --filter @jarvis/gateway

# TypeScript source + config, then compile
COPY apps/gateway/src ./apps/gateway/src
COPY apps/gateway/tsconfig.json ./apps/gateway/
RUN cd apps/gateway && pnpm exec tsc

# Stage 2: runtime — production deps only, compiled JS
FROM node:22-slim AS runtime

WORKDIR /app

RUN npm install -g pnpm@10.33.2

COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
COPY apps/gateway/package.json ./apps/gateway/
RUN pnpm install --frozen-lockfile --filter @jarvis/gateway --prod

COPY --from=builder /app/apps/gateway/dist ./apps/gateway/dist

# env vars injected by docker-compose env_file — NOT --env-file flag (different mechanism)
WORKDIR /app/apps/gateway
CMD ["node", "dist/index.js"]
