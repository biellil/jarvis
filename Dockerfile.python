# Stage 1: builder — install deps and compile
FROM python:3.12-slim AS builder

WORKDIR /app

# Layer 1: dep manifests for cache efficiency
COPY pyproject.toml requirements-docker.txt ./

# Install all deps except openwakeword (which requires tflite-runtime that has no
# Python 3.12 wheels on Linux). openwakeword uses onnxruntime at runtime — tflite
# is vestigial in its package metadata. Install with --no-deps to skip tflite-runtime.
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-docker.txt && \
    pip install --no-cache-dir --no-deps openwakeword==0.6.0

# Layer 2: application source (separate from deps for faster rebuilds on code changes)
COPY src/ ./src/

# Install the package itself (without re-resolving deps — already installed above)
RUN pip install --no-cache-dir --no-deps .

# Stage 2: runtime — lean image with only what's needed at runtime
FROM python:3.12-slim AS runtime

WORKDIR /app

# CRITICAL: system libs needed by native Python packages at runtime
# libgomp1    — ctranslate2/faster-whisper (OpenMP)
# libsndfile1 — soundfile/kokoro
# libportaudio2 — sounddevice
# espeak-ng   — kokoro phonemizer on Linux
# curl        — healthcheck CMD
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libsndfile1 \
    libportaudio2 \
    espeak-ng \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages \
                    /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application source
COPY --from=builder /app/src ./src
COPY --from=builder /app/pyproject.toml ./

# Ensure data directory exists (will be overridden by volume mount)
RUN mkdir -p /app/data

# Single worker — in-memory session_store breaks with >1 (per D-04, Phase 6 D-01)
CMD ["uvicorn", "jarvis.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
