# ============================================
# LLM
# ============================================
# Provider: lmstudio | openai | anthropic
LLM_PROVIDER=lmstudio
LLM_MODEL=

# LM Studio (used when LLM_PROVIDER=lmstudio)
# For Docker: use http://host.docker.internal:1234/v1 (Linux requires extra_hosts: host-gateway)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic / Claude (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ============================================
# Memory (ChromaDB)
# ============================================
CHROMA_PATH=data/chroma

# ============================================
# Backend TS (Phase 14+)
# ============================================
BACKEND_TS_PORT=8001

# ============================================
# Gateway (Express)
# ============================================
GATEWAY_PORT=3000
BACKEND_TS_URL=http://localhost:8001

# ============================================
# Auth (Phase 18.5) — mesma chave em todos os apps
# Gera com: openssl rand -hex 32
# ============================================
JARVIS_API_KEY=

# ============================================
# Desktop (Electron)
# ============================================
JARVIS_BACKEND_URL=http://localhost:3000

# ============================================
# Voice (Phase 19 + Phase 24)
# ============================================
# TTS_PROVIDER: elevenlabs | murf | local
#   - elevenlabs: requer ELEVENLABS_API_KEY. Cloud. Voz Sarah (pt-BR ok via multilingual_v2).
#   - murf: requer MURF_API_KEY. Cloud. Voz pt-BR masculina (Heitor default). Adicionado Phase 24.
#   - local: Speecht5 via Transformers.js. Free, qualidade ruim em pt-BR. Fallback automático quando a API key do provider cloud escolhido está ausente.
# PRIVACY: providers cloud enviam APENAS o texto da resposta do LLM (não áudio do usuário) para a API. Áudio nunca sai do dispositivo (STT roda local via nodejs-whisper).
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Murf.ai — obter em https://murf.ai/api/pricing
MURF_API_KEY=
# Voice ID — default "pt-BR-heitor" (masculino pt-BR, style Conversation).
# Alternativas pt-BR masculinas: pt-BR-gustavo, pt-BR-benicio, pt-BR-silvio, pt-BR-yago.
# Confirmar format via: curl -H "api-key: $MURF_API_KEY" https://api.murf.ai/v1/speech/voices
MURF_VOICE_ID=pt-BR-heitor

# STT_PROVIDER: local (nodejs-whisper)
STT_PROVIDER=local
# WHISPER_MODEL: tiny | base | small | medium | large-v3-turbo
WHISPER_MODEL=base
