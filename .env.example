# ============================================
# LLM
# ============================================
# Provider: lmstudio | openai | anthropic
LLM_PROVIDER=lmstudio
LLM_MODEL=

# LM Studio (used when LLM_PROVIDER=lmstudio)
# For Docker: use http://host.docker.internal:1234/v1 (Linux requires extra_hosts: host-gateway)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic / Claude (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ============================================
# Memory (SQLite + ChromaDB)
# ============================================
SQLITE_PATH=data/jarvis.db
CHROMA_PATH=data/chroma

# ============================================
# Backend TS (Phase 14+)
# ============================================
BACKEND_TS_PORT=8001

# ============================================
# Gateway (Express)
# ============================================
GATEWAY_PORT=3000
BACKEND_TS_URL=http://localhost:8001

# FastAPI URL (gateway -> python service, legado — usado só na Phase 20 E2E)
# For Docker: overridden to http://python-service:8000 by docker-compose.yml (internal network)
FASTAPI_URL=http://localhost:8000

# ============================================
# Auth (Phase 18.5) — mesma chave em todos os apps
# Gera com: openssl rand -hex 32
# ============================================
JARVIS_API_KEY=

# ============================================
# Desktop (Electron)
# ============================================
JARVIS_BACKEND_URL=http://localhost:3000

# ============================================
# Voice (Phase 19)
# ============================================
# TTS_PROVIDER: elevenlabs (requer ELEVENLABS_API_KEY) | local (Speecht5, free mas qualidade ruim pt-BR)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# STT_PROVIDER: local (nodejs-whisper)
STT_PROVIDER=local
# WHISPER_MODEL: tiny | base | small | medium | large-v3-turbo
WHISPER_MODEL=base
