# ============================================
# LLM
# ============================================
# Provider: lmstudio | openai | anthropic | gemini
LLM_PROVIDER=lmstudio
LLM_MODEL=

# LM Studio (used when LLM_PROVIDER=lmstudio)
# For Docker: use http://host.docker.internal:1234/v1 (Linux requires extra_hosts: host-gateway)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=
# true = usa SSE nativo /api/v1/chat do LM Studio (mais rápido)
# false = fallback OpenAI-compat (default seguro)
USE_LM_STUDIO_STREAMING_EVENTS=false

# Google Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic / Claude (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ============================================
# Memory (ChromaDB)
# ============================================
CHROMA_PATH=data/chroma
# Para Docker: CHROMA_HOST=chromadb (nome do serviço docker-compose)
# Para dev local: deixar em branco (default: localhost)
CHROMA_HOST=
CHROMA_PORT=8000

# ============================================
# Backend TS (Phase 14+)
# ============================================
BACKEND_TS_PORT=8001

# ============================================
# Gateway (Express)
# ============================================
GATEWAY_PORT=3000
BACKEND_TS_URL=http://localhost:8001
GATEWAY_URL=http://localhost:3000

# ============================================
# Auth (Phase 18.5) — mesma chave em todos os apps
# Gera com: openssl rand -hex 32
# ============================================
JARVIS_API_KEY=

# ============================================
# Desktop (Electron)
# ============================================
JARVIS_BACKEND_URL=http://localhost:3000

# ============================================
# Voice (Phase 19 + Phase 24)
# ============================================
# TTS_PROVIDER: elevenlabs | murf | local
#   - elevenlabs: requer ELEVENLABS_API_KEY. Cloud. Voz Sarah (pt-BR ok via multilingual_v2).
#   - murf: requer MURF_API_KEY. Cloud. Voz pt-BR masculina (Heitor default). Adicionado Phase 24.
#   - local: Speecht5 via Transformers.js. Free, qualidade ruim em pt-BR. Fallback automático quando a API key do provider cloud escolhido está ausente.
# PRIVACY: providers cloud enviam APENAS o texto da resposta do LLM (não áudio do usuário) para a API. Áudio nunca sai do dispositivo (STT roda local via nodejs-whisper).
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Murf.ai — obter em https://murf.ai/api/pricing
MURF_API_KEY=
# Voice ID — default "pt-BR-heitor" (masculino pt-BR, style Conversation).
# Alternativas pt-BR masculinas: pt-BR-gustavo, pt-BR-benicio, pt-BR-silvio, pt-BR-yago.
# Confirmar format via: curl -H "api-key: $MURF_API_KEY" https://api.murf.ai/v1/speech/voices
MURF_VOICE_ID=pt-BR-heitor

# STT_PROVIDER: local (nodejs-whisper)
STT_PROVIDER=local
# WHISPER_MODEL: tiny | base | small | medium | large-v3
#   - tiny: ~75MB, very fast, low accuracy (dev/testing only)
#   - base: ~142MB, fast, decent accuracy
#   - small: ~460MB, moderate speed, good accuracy
#   - medium: ~1.5GB, 2x slower than base, significantly better accuracy (recommended for pt-BR)
#   - large-v3: ~3GB, 4x slower than base, best accuracy (overkill for personal assistant)
# Note: Docker build uses CPU-only. For GPU acceleration, compile whisper.cpp on host with Vulkan/CUDA.
# Recommendation: medium for accuracy/speed balance (requires ~2GB RAM)
WHISPER_MODEL=small

# Phase 29 (STT): Local whisper.cpp STT via @fugood/whisper.node
# Default: false — uses gateway audio upload (Phase 28 behavior)
# Set to true to enable local transcription with GPU auto-detection
# WARNING: requires @fugood/whisper.node binaries built for your platform
USE_WHISPER_CPP=false

# ============================================
# MCP Client (Phase 65) — JARVIS conecta a 1 servidor MCP externo (ex: n8n)
# ============================================
# MCP_SERVER_URL: HTTP/HTTPS endpoint do servidor MCP. Vazio = cliente desligado (boot silencioso).
#   Exemplos:
#     n8n cloud:    https://yourname.app.n8n.cloud/mcp/<workflow-id>
#     n8n local:    http://localhost:5678/mcp/<path>
#     Pipedream:    https://mcp.pipedream.com/<token>/<app>
#     Zapier MCP:   https://mcp.zapier.com/mcp/<id>/sse
# Transport: StreamableHTTP primary, SSE fallback (handled automatically).
MCP_SERVER_URL=

# MCP_SERVER_BEARER: Token enviado em "Authorization: Bearer <token>" para o servidor.
#   NUNCA commite um token real. Use .env.local (gitignored) para o valor.
#   n8n: gere via "Header Auth" credential no workflow MCP Server Trigger.
MCP_SERVER_BEARER=

# MCP_SERVER_NAME: Identifier curto (ex: "n8n", "pipedream"). Usado como prefixo
#   das tools externas no agent (ex: send_email vira "n8n.send_email") e em logs.
#   Default seguro se vazio: "mcp".
MCP_SERVER_NAME=

# ⚠️  TRUST MODE (D-14): Tools MCP externas executam SEM toast de confirmação.
#   Você (usuário) é responsável por confiar no servidor configurado acima.
#   Tools com side-effect real (envio de email, criação de fatura) executam diretamente
#   quando o LLM decidir chamá-las em conversa. Use apenas servidores MCP que você controla
#   ou nos quais confia explicitamente.
#
# 🔄 HOT RELOAD (D-09): Editar este arquivo (.env ou .env.local) recarrega o cliente
#   MCP automaticamente sem restart. Tools novas aparecem na próxima conversa (D-11).
