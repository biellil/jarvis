# ============================================
# Backend TS — JARVIS Express + LangChain runtime
# ============================================
# Most env vars (LLM_PROVIDER, LM_STUDIO_URL, BACKEND_TS_PORT, MCP_*, etc.) are
# documented in the repo-root .env.example. This file contains only the flags
# that are owned exclusively by the backend service.

# ─── Phase 66: Agentic Tasks ────────────────────────────────────
# Default: unset (agentic graph enabled). Set to "true" to disable the
# planner-first routing and force every chat turn through the legacy
# direct-agent path. Useful for debugging chat latency or when the local
# LLM is unreliable for withStructuredOutput (smaller 3B/7B models can
# fail Zod parsing repeatedly — fall back to direct mode while you swap
# to a larger instruct model).
# AGENTIC_DISABLED=true
