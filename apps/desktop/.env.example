# ============================================
# Wake Word (Phase 22 — v1.4)
# ============================================
# Prefixo VITE_ é obrigatório — engine roda no renderer e consome via
# import.meta.env. Defaults travados em .planning/phases/22-.../22-CONTEXT.md.
# Este arquivo reside em apps/desktop/ e é lido por Vite graças ao envDir
# explícito configurado em electron.vite.config.ts (renderer block).
VITE_WAKE_WORD_ENABLED=true
VITE_WAKE_WORD_THRESHOLD=0.5
# DEPRECATED Phase 24 — substituído por VITE_WAKE_WORD_MAX_RECORDING_MS abaixo.
# Ainda lido para compat de transição, mas o semantics mudou: na Phase 22 era
# "hard timeout" (fixed 3s); a partir da Phase 24 a captura termina via Silero
# VAD (@ricky0123/vad-web) e este valor vira só fallback legado. Remover em v1.5.
VITE_WAKE_WORD_VAD_TIMEOUT_MS=3000
VITE_WAKE_WORD_MODEL=hey_jarvis_v0.1

# Phase 24 — VAD max recording fallback (D-03)
# Fallback absoluto: se o Silero VAD nunca detectar fim de fala depois do wake
# word (mic mudo, usuário silencioso), aborta a captura após N ms e mostra toast
# "Não ouvi nada. Diga Hey JARVIS de novo." O fluxo normal termina antes via
# redemptionMs do próprio VAD (~1400ms padrão da lib), então 6000ms é só
# safety net generoso.
VITE_WAKE_WORD_MAX_RECORDING_MS=6000
