{
  "name": "@jarvis/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "cross-env ELECTRON_EXTRA_LAUNCH_ARGS=--no-sandbox electron-vite dev --watch",
    "build": "electron-vite build",
    "build:dist": "electron-vite build && electron-builder --config electron-builder.yml",
    "build:dist:win": "electron-vite build && electron-builder --config electron-builder.yml --win",
    "build:dist:mac": "electron-vite build && electron-builder --config electron-builder.yml --mac",
    "build:dist:linux": "electron-vite build && electron-builder --config electron-builder.yml --linux",
    "start": "cross-env ELECTRON_EXTRA_LAUNCH_ARGS=--no-sandbox electron-vite preview",
    "test": "vitest",
    "postinstall": "node ../../scripts/download-wakeword-models.mjs",
    "verify:wake-word-bans": "node ../../scripts/verify-no-banned-wake-word-libs.mjs"
  },
  "dependencies": {
    "audiobuffer-to-wav": "1.0.0",
    "electron-store": "^11.0.2",
    "onnxruntime-web": "1.24.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "happy-dom": "20.8.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.2"
  }
}
