# Dockerfile com suporte GPU Vulkan (AMD/Intel/NVIDIA)
# ATENÇÃO: Só funciona em Linux host nativo (não Windows/macOS)
#
# Uso:
#   Linux: docker compose -f docker-compose.gpu.yml build
#   Requer: drivers GPU instalados no host, /dev/dri acessível
#
# Para Windows/macOS: use Dockerfile.backend-ts (CPU-only) ou hybrid architecture

# Stage 1: Builder - includes build tools for native modules + GPU
FROM node:22-slim AS builder

WORKDIR /app

# Install build tools + Vulkan development libraries
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    libsqlite3-dev \
    # GPU support - Vulkan development headers
    libvulkan-dev \
    vulkan-tools \
    mesa-vulkan-drivers \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm@10.33.2

# Copy package files
COPY apps/backend-ts/package.json ./
COPY pnpm-lock.yaml ./

# Install all dependencies (including devDependencies for TypeScript compilation)
RUN pnpm install --no-frozen-lockfile

# Copy source code
COPY apps/backend-ts/src ./src
COPY apps/backend-ts/tsconfig.json ./

# Compile TypeScript to JavaScript
RUN pnpm exec tsc

# Stage 2: Runtime - production with GPU runtime support
FROM node:22-slim AS runtime

WORKDIR /app

# Install runtime dependencies + Vulkan runtime (no dev headers)
RUN apt-get update && apt-get install -y \
    curl \
    ffmpeg \
    libsqlite3-dev \
    # GPU runtime libraries (smaller than -dev packages)
    libvulkan1 \
    vulkan-tools \
    mesa-vulkan-drivers \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm@10.33.2

# Copy package files
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-lock.yaml ./

# Install production dependencies only
RUN pnpm install --prod --frozen-lockfile

# Copy compiled JavaScript from builder
COPY --from=builder /app/dist ./dist

# Copy Drizzle migration files (SQL + _journal.json — needed at runtime)
COPY --from=builder /app/src/memory/migrations ./src/memory/migrations

# Set environment defaults
ENV NODE_ENV=production
ENV BACKEND_TS_PORT=8001

# Vulkan configuration
# VK_ICD_FILENAMES: Tell Vulkan where to find GPU driver
# For AMD: radeon_icd.x86_64.json
# For Intel: intel_icd.x86_64.json
# For NVIDIA: nvidia_icd.json (with proprietary driver)
ENV VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.x86_64.json

# Expose port (documentation only, not published)
EXPOSE 8001

# Health check to verify GPU is accessible
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Start the server
CMD ["node", "dist/index.js"]
