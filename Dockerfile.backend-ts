# Stage 1: Builder - includes build tools for native modules
FROM node:22-slim AS builder

WORKDIR /app

# Install build tools for native modules (better-sqlite3)
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm@10.33.2

# Workspace context — required for frozen-lockfile and root onlyBuiltDependencies
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
COPY apps/backend-ts/package.json ./apps/backend-ts/

# Install all dependencies (including devDependencies for TypeScript compilation)
RUN pnpm install --frozen-lockfile --filter @jarvis/backend-ts

# Copy source code
COPY apps/backend-ts/src ./apps/backend-ts/src
COPY apps/backend-ts/tsconfig.json ./apps/backend-ts/

# Compile TypeScript to JavaScript
RUN cd apps/backend-ts && pnpm exec tsc

# Stage 2: Runtime - production only
FROM node:22-slim AS runtime

WORKDIR /app

# Install runtime dependencies for native modules and curl for health checks
RUN apt-get update && apt-get install -y \
    curl \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm@10.33.2

# Workspace context
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
COPY apps/backend-ts/package.json ./apps/backend-ts/

# Install production dependencies only
RUN pnpm install --frozen-lockfile --filter @jarvis/backend-ts --prod

# Copy compiled JavaScript from builder
COPY --from=builder /app/apps/backend-ts/dist ./apps/backend-ts/dist

# Copy Drizzle migration files (SQL + _journal.json — needed at runtime)
COPY --from=builder /app/apps/backend-ts/src/memory/migrations ./apps/backend-ts/src/memory/migrations

# Set environment defaults
ENV NODE_ENV=production
ENV BACKEND_TS_PORT=8001

# Expose port (documentation only, not published)
EXPOSE 8001

# Run from app dir so Node.js resolves node_modules via pnpm workspace symlinks
WORKDIR /app/apps/backend-ts
CMD ["node", "dist/index.js"]
