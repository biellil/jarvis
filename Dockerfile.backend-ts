# Stage 1: Builder - includes build tools for native modules
FROM node:22-slim AS builder

WORKDIR /app

# Install pnpm globally
RUN npm install -g pnpm

# Install build tools for native modules (better-sqlite3)
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY apps/backend-ts/package.json ./
COPY apps/backend-ts/pnpm-lock.yaml* ./

# Install all dependencies (including devDependencies for TypeScript compilation)
RUN pnpm install 

# Copy source code
COPY apps/backend-ts/src ./src
COPY apps/backend-ts/tsconfig.json ./

# Compile TypeScript to JavaScript
RUN pnpm exec tsc

# Stage 2: Runtime - production only
FROM node:22-slim AS runtime

WORKDIR /app

# Install pnpm globally
RUN npm install -g pnpm

# Install runtime dependencies for native modules and curl for health checks
RUN apt-get update && apt-get install -y \
    curl \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-lock.yaml* ./

# Install production dependencies only
RUN pnpm install

# Copy compiled JavaScript from builder
COPY --from=builder /app/dist ./dist

# Copy Drizzle migration files (SQL + _journal.json — needed at runtime)
COPY --from=builder /app/src/memory/migrations ./src/memory/migrations

# Set environment defaults
ENV NODE_ENV=production
ENV BACKEND_TS_PORT=8001

# Expose port (documentation only, not published)
EXPOSE 8001

# Start the server
CMD ["node", "dist/index.js"]